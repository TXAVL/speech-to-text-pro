# Cấu hình Cổng máy chủ (Mặc định: 3000)
PORT=3000

# (Tùy chọn) API Keys để server tự dùng mà không cần nhập trên trình duyệt
# Lấy miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY=

# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# (Tùy chọn) Tắt Cloudflare Tunnel nếu chạy trên Host/VPS đã có Domain sẵn (true / false)
DISABLE_TUNNEL=false
